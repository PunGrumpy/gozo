{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "noUpdateNotifier": true,
  // Host environment for cargo, rustup, go and GitHub Actions.
  "globalPassThroughEnv": [
    "Path",
    "APPDATA",
    "LOCALAPPDATA",
    "TMPDIR",
    "HOME",
    "TMP",
    "USERPROFILE",
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUSTFLAGS",
    "RUSTC_WRAPPER",
    "CARGO_INCREMENTAL",
    "CARGO_BUILD_JOBS",
    "GOPATH",
    "GOCACHE",
    "GOMODCACHE",
    "GOTOOLCHAIN",
    "SCCACHE_GHA_ENABLED",
    "ACTIONS_CACHE_URL",
    "ACTIONS_RUNTIME_TOKEN"
  ],
  // Rust and Go outputs differ per OS.
  "globalEnv": ["OS", "RUNNER_OS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#build:rust": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ]
    },
    "//#test:rust": {
      "inputs": ["crates/**", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml"]
    },
    "//#check:rust": {
      "inputs": [
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "clippy.toml"
      ]
    },
    "//#format:rust": {
      "inputs": ["crates/**", ".rustfmt.toml"]
    },
    "//#fix:rust": {
      "cache": false
    },

    "//#check": {
      "inputs": ["$TURBO_DEFAULT$", "!crates/**", "!target/**", "!.turbo/**"]
    },
    "//#fix": {
      "cache": false
    },
    "//#quality": {
      "dependsOn": [
        "//#check",
        "//#check:rust",
        "//#format:rust",
        "//#test:rust"
      ]
    }
  }
}
